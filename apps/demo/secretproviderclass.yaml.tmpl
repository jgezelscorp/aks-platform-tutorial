# SecretProviderClass — binds the demo workload identity to Key Vault and projects
# 'demo-secret' as a file under the CSI mount. clientID = the demo managed identity's
# client id (Workload Identity, so usePodIdentity/useVMManagedIdentity both false).
# Templated: ${DEMO_CLIENT} ${KV_NAME} ${TENANT_ID} filled by 07-deploy-demo.sh.
apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata:
  name: demo-kv
  namespace: demo
spec:
  provider: azure
  parameters:
    usePodIdentity: "false"
    useVMManagedIdentity: "false"
    clientID: "${DEMO_CLIENT}"
    keyvaultName: "${KV_NAME}"
    tenantId: "${TENANT_ID}"
    objects: |
      array:
        - |
          objectName: demo-secret
          objectType: secret
