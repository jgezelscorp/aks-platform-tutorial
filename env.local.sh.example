# ---- env.local.sh.example : template for private overrides ----
# Copy this file to env.local.sh (git-ignored) and fill in your real values.
#   cp env.local.sh.example env.local.sh
# env.sh sources env.local.sh automatically, so these values override the
# placeholders in env.sh without ever landing in source control.

# Microsoft Entra ID group object IDs (az ad group show --group "<name>" --query id -o tsv)
export ADMIN_GROUP=<your-aks-admin-group-object-id>
export AKS_ADMIN=<your-aks-admin-group-object-id>
export AKS_DEV=<your-aks-developer-group-object-id>
export AKS_READ=<your-aks-reader-group-object-id>

# Subscription + tenant to pin every script to the right context. Governed
# subscriptions can silently flip your default context, so we pin explicitly.
export SUB_ID=<your-subscription-id>
export TENANT_ID=<your-tenant-id>
az account set --subscription "$SUB_ID" 2>/dev/null || true

# Region override (env.sh defaults to westeurope). Set to wherever you deploy.
export LOCATION=<your-azure-region>
